# Copy to .env; never commit real credentials.
# This configuration uses OpenAI for both LLM extraction and embeddings.
LLM_API_KEY=
# Set an exact Cognee-compatible model ID available to your API account.
LLM_MODEL=
# Set a unique password, at least 8 characters. Hex avoids dotenv escaping issues.
# Generate one with: openssl rand -hex 24
NEO4J_PASSWORD=
